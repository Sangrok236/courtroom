# Gemini 또는 OpenAI 중 하나만 설정하면 됩니다.
# AI_PROVIDER는 선택입니다(gemini | openai). 비우면 가진 키로 자동 선택하며 둘 다 있으면 Gemini를 씁니다.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# 새 형식 키('AQ.'로 시작)와 기존 'AIza' 키 모두 사용할 수 있습니다.
# 선택: 모델. 비우면 gemini-3.8-flash / gpt-4.1-mini (공급자별로 GEMINI_MODEL, OPENAI_MODEL도 가능)
AI_MODEL=

OPENAI_API_KEY=
